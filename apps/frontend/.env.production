# .env.production

NEXT_PUBLIC_API_URL=

# ✅ Server-only: used only by next.config.mjs for the rewrite destination
BACKEND_URL=

# CORS_ORIGIN on the Express side
CORS_ORIGIN=


# apps/frontend/.env.local
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=


# Must be the same client ID — the frontend uses it to initialise the Google SDK
# NEXT_PUBLIC_ prefix makes it available in the browser bundle
NEXT_PUBLIC_GOOGLE_CLIENT_ID=